{
  "name": "jumpgame",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "predev": "node scripts/optimize-assets.mjs && node scripts/build-credits.mjs",
    "dev": "vite",
    "prebuild": "node scripts/optimize-assets.mjs && node scripts/build-credits.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "set-editor-password": "node scripts/set-editor-password.mjs",
    "typecheck": "tsc --noEmit",
    "level": "node scripts/generate-level.mjs public/levels/ruins.json && node scripts/check-level.mjs public/levels/ruins.json && node scripts/simulate-route.mjs public/levels/ruins.json && node scripts/check-platforms.mjs public/levels/ruins.json",
    "level:generate": "node scripts/generate-level.mjs public/levels/ruins.json",
    "level:check": "node scripts/check-level.mjs public/levels/ruins.json",
    "level:sim": "node scripts/simulate-route.mjs public/levels/ruins.json",
    "level:platforms": "node scripts/check-platforms.mjs public/levels/ruins.json",
    "gen:foliage": "node scripts/gen-foliage.mjs",
    "gen:models": "node scripts/gen-models.mjs",
    "gen:textures": "node scripts/gen-textures.mjs",
    "gen:audio": "node scripts/gen-audio.mjs",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "audit-assets": "node scripts/audit-assets.mjs",
    "optimize-character": "node scripts/optimize-character.mjs",
    "build-credits": "node scripts/build-credits.mjs",
    "hub": "node scripts/generate-hub.mjs public/levels/hub.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@radix-ui/react-menubar": "^1.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "meshoptimizer": "^0.21.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
