# Copy to .env and fill in, or just run: npm run set-editor-password
# .env is gitignored — never commit real values.

# Generated by scripts/set-editor-password.mjs. Without these three the game
# still runs, but the editor is disabled server-side and no one can log in.
EDITOR_PASSWORD_SALT=
EDITOR_PASSWORD_HASH=
SESSION_SECRET=

# Where the server listens. Behind nginx, keep this on localhost.
PORT=8080
HOST=0.0.0.0

# Set to 1 when running behind nginx / any reverse proxy, so the login rate
# limiter reads the real client IP from X-Forwarded-For instead of seeing
# every visitor as the proxy itself.
TRUST_PROXY=0

# Built game to serve, and where the editor writes levels. LEVELS_DIR defaults
# to <DIST_DIR>/levels. Point it somewhere persistent if you redeploy by
# replacing dist/, or your saved levels get wiped on every deploy.
DIST_DIR=dist
# LEVELS_DIR=/var/lib/jumpgame/levels
